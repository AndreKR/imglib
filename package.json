{
  "name": "@andrekr/imglib",
  "version": "0.1.1",
    "private": true,
  "license": "MIT",
  "author": "André Hänsel",
  "description": "A TypeScript image library backed by sharp",
    "repository": {
      "type": "git",
      "url": "git+https://github.com/AndreKR/imglib.git"
    },
    "homepage": "https://github.com/AndreKR/imglib#readme",
    "bugs": {
      "url": "https://github.com/AndreKR/imglib/issues"
    },
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node scripts/clean.mjs && tsc -p tsconfig.build.json && node scripts/prepare-package.mjs",
    "release": "yarn run build && npm publish ./dist",
    "test": "vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "sharp": "^0.33.5"
  },
  "devDependencies": {
    "@types/node": "22.10.2",
    "typescript": "5.7.2",
    "vitest": "2.1.8"
  },
  "packageManager": "yarn@4.17.0"
}
